set(NEOLIB_VERSION @PROJECT_VERSION@)

@PACKAGE_INIT@

# (the dependencies that neolib's targets link to: found before the targets are imported)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(WIN32)
    set(Boost_USE_STATIC_LIBS ON)
    set(Boost_USE_STATIC_RUNTIME ON)
endif()
find_dependency(Boost COMPONENTS chrono filesystem thread fiber locale)
find_dependency(OpenSSL COMPONENTS SSL)
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/neolibTargets.cmake")

check_required_components(neolib)
